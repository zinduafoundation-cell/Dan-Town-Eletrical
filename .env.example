# Supabase database and client configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

# n8n automation integration
N8N_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/your-workflow
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Paystack integration
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace-with-your-public-key

# Application (use the Vercel/custom production URL in Vercel; localhost is for local development only)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ALLOW_AUTH_BYPASS=false
OPENAI_API_KEY=replace-with-your-server-only-openai-key
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional server-only admin/CEO secondary gate. Generate with the command in the setup docs.
DANTOWN_QUICK_ACCESS_PIN_HASH=scrypt$replace-with-salt-hex$replace-with-derived-key-hex
DANTOWN_QUICK_ACCESS_COOKIE_SECRET=replace-with-a-long-random-server-secret
GOOGLE_MAPS_SERVER_API_KEY=
DANTOWN_DELIVERY_ORIGIN=Dantown Electrical, Kitale, Kenya
DELIVERY_BASE_FEE_KES=250
DELIVERY_RATE_PER_KM_KES=25
