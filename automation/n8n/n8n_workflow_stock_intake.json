{
  "name": "Stock Intake - Supplier Invoice",
  "nodes": [
    {
      "parameters": {},
      "id": "08d4889f9e",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/automation/stock-intake",
        "authentication": "headerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-dantown-automation-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "contentType": "application/json",
        "body": {
          "json": {
            "source": "N8N",
            "workflow_name": "DANTOWN_STOCK_INTAKE",
            "supplier_name": "{{ $node[\"Manual Trigger\"].json.supplier_name || \"Unknown Supplier\" }}",
            "supplier_reference": "{{ $node[\"Manual Trigger\"].json.invoice_number || \"\" }}",
            "received_at": "{{ $now.toISOString() }}",
            "transport_cost": "{{ $node[\"Manual Trigger\"].json.transport_cost || 0 }}",
            "other_costs": "{{ $node[\"Manual Trigger\"].json.other_costs || 0 }}",
            "items": "{{ $node[\"Manual Trigger\"].json.items }}"
          }
        }
      },
      "id": "a1b2c3d4e5",
      "name": "Send to Dantown API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300],
      "credentials": {
        "httpHeaderAuth": "httpHeaderAuth"
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $node[\"Send to Dantown API\"].statusCode }}",
              "value2": 200,
              "operation": "equal"
            }
          ]
        }
      },
      "id": "f6g7h8i9j0",
      "name": "Check Response Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "jsCode": "return {\n  status: 'success',\n  message: 'Stock intake submitted successfully',\n  jobId: $node['Send to Dantown API'].json.jobId,\n  itemCount: $node['Send to Dantown API'].json.itemCount,\n  timestamp: $now.toISOString()\n};"
      },
      "id": "k1l2m3n4o5",
      "name": "Success Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [950, 200]
    },
    {
      "parameters": {
        "jsCode": "return {\n  status: 'error',\n  message: 'Failed to submit stock intake',\n  statusCode: $node['Send to Dantown API'].statusCode,\n  error: $node['Send to Dantown API'].json,\n  timestamp: $now.toISOString()\n};"
      },
      "id": "p6q7r8s9t0",
      "name": "Error Handler",
      "type": "n8n-nodes-base-code",
      "typeVersion": 2,
      "position": [950, 400]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Send to Dantown API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Dantown API": {
      "main": [
        [
          {
            "node": "Check Response Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response Status": {
      "main": [
        [
          {
            "node": "Success Handler",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Africa/Nairobi"
  },
  "tags": ["Stock Intake", "Supplier", "Automation"],
  "versionId": "1.0.0"
}
